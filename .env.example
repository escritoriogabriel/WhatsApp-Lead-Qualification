# As chaves do painel selecionam provedor/modelo; os segredos ficam fora de config/qualification.json.
GEMINI_API_KEY=<chave-do-google-ai-studio>
GEMINI_MODEL=gemini-3.5-flash
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Opcional para o container app do Compose; por padrão acessa o Ollama instalado no host.
OLLAMA_API_URL_DOCKER=http://host.docker.internal:11434

# Fallback de primeira inicialização. Depois, o provedor salvo pelo painel prevalece.
WHATSAPP_PROVIDER=waha
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=<segredo-aleatorio>
WAHA_SESSION=triagem
WAHA_WEBHOOK_URL=http://localhost:3000/api/waha/webhook
WAHA_WEBHOOK_SECRET=<outro-segredo-aleatorio>
WAHA_IMAGE=devlikeapro/waha:gows
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=<senha-forte-unica>

# Preencha ao selecionar WHATSAPP_PROVIDER=meta.
META_ACCESS_TOKEN=<token-de-acesso-meta>
META_PHONE_NUMBER_ID=<id-do-numero-business>
META_GRAPH_API_VERSION=v27.0
META_APP_SECRET=<app-secret-meta>
META_WEBHOOK_VERIFY_TOKEN=<token-de-verificacao-proprio>

DATABASE_PATH=data/agent.sqlite
AUTH_DIR=data/auth
MEDIA_DIR=data/tmp
CONFIG_PATH=config/qualification.json
HUMAN_NOTIFY_JID=
LOG_LEVEL=info
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Deixe vazio para gerar senha em data/panel-password.
PANEL_PASSWORD=
