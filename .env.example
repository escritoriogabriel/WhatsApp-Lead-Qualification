GEMINI_API_KEY=<sua-chave-gemini>
GEMINI_MODEL=gemini-3.5-flash
WHATSAPP_PROVIDER=baileys
# Para usar WAHA fora do Docker Compose, informe o endereço acessível pelo processo Node.
WAHA_API_URL=http://localhost:3001
WAHA_API_KEY=troque-por-uma-chave-aleatoria
WAHA_SESSION=triagem
WAHA_WEBHOOK_URL=http://localhost:3000/api/waha/webhook
WAHA_WEBHOOK_SECRET=troque-por-outro-segredo-aleatorio
# Usado pelo Compose e pelo painel web do WAHA; substitua antes de subir os serviços.
WAHA_IMAGE=devlikeapro/waha:gows
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-por-uma-senha-forte
DATABASE_PATH=data/agent.sqlite
AUTH_DIR=data/auth
MEDIA_DIR=data/tmp
CONFIG_PATH=config/qualification.json
HUMAN_NOTIFY_JID=
LOG_LEVEL=info
PANEL_HOST=127.0.0.1
PANEL_PORT=3000
# Deixe vazio para gerar uma senha em data/panel-password na primeira execução.
PANEL_PASSWORD=
